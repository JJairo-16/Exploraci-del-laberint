<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Directori de logs -->
    <property name="LOG_DIR" value="maze/logs"/>

    <!-- ===== APPENDER CONSOLE ===== -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ===== APPENDER FILE (GENERAL) ===== -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/app.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ===== APPENDER FILE (ITEMS) ===== -->
    <appender name="ITEM_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/items.log</file>

        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/items.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>14</maxHistory>
        </rollingPolicy>

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- ===== LOGGER EXCLUSIVO PARA ItemLogger ===== -->
    <!-- additivity="false" evita que también vaya a ROOT (app.log/console) -->
    <logger name="com.jairo.utils.ItemLogger" level="INFO" additivity="false">
        <appender-ref ref="ITEM_FILE"/>
    </logger>

    <!-- ===== ROOT LOGGER ===== -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

    <!-- ===== PAQUET ===== -->
    <logger name="com.jairo" level="DEBUG"/>

</configuration>
