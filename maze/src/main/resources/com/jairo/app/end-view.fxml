<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.jairo.app.EndController">

    <VBox alignment="CENTER"
          spacing="14">

        <Label text="%end.title" styleClass="title-text"/>
        <Label text="%end.subtitle" wrapText="true" styleClass="exit-text"/>

        <!-- PANEL MONEDAS (integrado en la pantalla final) -->
        <HBox fx:id="coinsPanel"
              spacing="12"
              styleClass="coins-panel"
              alignment="CENTER">
            <ImageView fx:id="coinIcon"
                       fitWidth="54"
                       fitHeight="54"
                       preserveRatio="true"
                       styleClass="coin-icon"/>
            <Label text="%end.coins"
                   styleClass="coins-title"/>
            <Label fx:id="coinsLabel"
                   text="0"
                   styleClass="coins-value"/>
        </HBox>

        <Button text="%end.exit" onAction="#onExit" prefWidth="200"/>
    </VBox>

    <Label text="%credits.text"
           styleClass="credits-text"
           StackPane.alignment="BOTTOM_RIGHT"/>

</StackPane>
