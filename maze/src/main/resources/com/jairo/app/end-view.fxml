<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.jairo.app.EndController">

    <VBox alignment="CENTER"
          spacing="14">

        <Label text="%end.title" styleClass="final-title-text"/>
        <Label text="%end.subtitle" wrapText="true"/>

        <Button text="%end.exit" onAction="#onExit" prefWidth="200"/>
    </VBox>

    <Label text="%credits.text"
           styleClass="credits-text"
           StackPane.alignment="BOTTOM_RIGHT"/>

</StackPane>
