<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Pane?>

<HBox fx:id="root"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.jairo.app.Controller"
      spacing="10">

  <StackPane fx:id="leftPane" HBox.hgrow="ALWAYS">
    <Canvas fx:id="mapCanvas"/>
    <Canvas fx:id="entitiesCanvas"/>
    <Canvas fx:id="postFxCanvas"/>
    <Canvas fx:id="hudCanvas"/>

    <StackPane fx:id="settingsOverlay"
              visible="false" managed="false"
              pickOnBounds="true"
              styleClass="settings-overlay">

        <!-- Fondo oscuro -->
        <Pane styleClass="settings-dim"/>

        <!-- Panel -->
        <VBox fx:id="settingsPanel"
              styleClass="settings-panel"
              spacing="10"
              maxWidth="420"
              maxHeight="520">

            <Label text="%settings.title" styleClass="title-text"/>

            <Separator styleClass="ui-separator"/>

            <Label text="%settings.audio" styleClass="settings-section-title"/>

            <!-- MASTER -->
            <VBox spacing="2" styleClass="settings-slider-block">
                <Label text="%settings.master" styleClass="fn-slider-name"/>
                <StackPane styleClass="fn-slider-wrap">
                    <Slider fx:id="masterSlider" min="0" max="1" value="0.9" styleClass="fn-slider"/>
                    <Label fx:id="masterPct" styleClass="fn-slider-pct"/>
                </StackPane>
            </VBox>

            <!-- BGM -->
            <VBox spacing="2" styleClass="settings-slider-block">
                <Label text="%settings.bgm" styleClass="fn-slider-name"/>
                <StackPane styleClass="fn-slider-wrap">
                    <Slider fx:id="bgmSlider" min="0" max="1" value="0.6" styleClass="fn-slider"/>
                    <Label fx:id="bgmPct" styleClass="fn-slider-pct"/>
                </StackPane>
            </VBox>

            <!-- SFX -->
            <VBox spacing="2" styleClass="settings-slider-block">
                <Label text="%settings.sfx" styleClass="fn-slider-name"/>
                <StackPane styleClass="fn-slider-wrap">
                    <Slider fx:id="sfxSlider" min="0" max="1" value="0.8" styleClass="fn-slider"/>
                    <Label fx:id="sfxPct" styleClass="fn-slider-pct"/>
                </StackPane>
            </VBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
              <CheckBox fx:id="muteCheck"/>
              <Label text="%settings.muteGame" styleClass="settings-checkbox-label"/>
            </HBox>

            <Separator styleClass="ui-separator"/>

            <!-- Botonera abajo -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="resetSettingsBtn"
                        text="%settings.reset"
                        onAction="#resetSettings"
                        styleClass="secondary"/>

                <Button fx:id="closeSettingsBtn"
                        text="%settings.close"
                        onAction="#closeSettings"
                        styleClass="secondary"/>

                <Button fx:id="saveSettingsBtn"
                        text="%settings.save"
                        onAction="#saveSettings"/>
            </HBox>
        </VBox>
    </StackPane>
  </StackPane>

  <VBox fx:id="rightPanel" spacing="10">
    <VBox fx:id="keybinds" spacing="8">
      <Label fx:id="topText"
             text="%controls.title"
             wrapText="true"
             styleClass="title-text" />

      <GridPane hgap="12" vgap="8" styleClass="key-grid">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="48" prefWidth="64"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
          <ColumnConstraints hgrow="NEVER" minWidth="48" prefWidth="64"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
        </columnConstraints>

        <Label text="A" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label text="%controls.left" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="D" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Label text="%controls.right" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="S" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label text="%controls.down" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="W" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Label text="%controls.up" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="E" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label text="%controls.use" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="SHIFT" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Label text="%controls.sprint" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
      </GridPane>

      <Separator styleClass="ui-separator"/>

      <GridPane hgap="12" vgap="8" styleClass="key-grid">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="48" prefWidth="64"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
          <ColumnConstraints hgrow="NEVER" minWidth="48" prefWidth="64"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
        </columnConstraints>

        <Label text="+" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label text="%controls.zoomIn" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="-" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Label text="%controls.zoomOut" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Z" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Label text="%controls.previousSkin" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="X" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <Label text="%controls.nextSkin" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="1" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Label text="%controls.prevItem" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Label text="2" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <Label text="%controls.nextItem" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
      </GridPane>

      <Separator styleClass="ui-separator"/>

      <GridPane hgap="12" vgap="8" styleClass="key-grid">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER" minWidth="48" prefWidth="64"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
          <ColumnConstraints hgrow="NEVER" minWidth="48" prefWidth="64"/>
          <ColumnConstraints hgrow="ALWAYS" minWidth="120"/>
        </columnConstraints>

        <Label text="F1" styleClass="key-label" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Label text="%controls.showFps" styleClass="key-description" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="F2" styleClass="key-label" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <Label text="%controls.switchPowerCoins" styleClass="key-description" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
      </GridPane>
    </VBox>

    <Separator styleClass="ui-separator"/>

    <VBox fx:id="language" spacing="6">
      <GridPane hgap="12" vgap="8">
        <columnConstraints>
          <ColumnConstraints hgrow="NEVER"/>
          <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>

        <Label text="%language.title" styleClass="section-title" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ChoiceBox fx:id="languageSelector" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
      </GridPane>
    </VBox>

    <Region VBox.vgrow="ALWAYS"/>

    <Label fx:id="blaiGlassesPowerText"
           text=""
           wrapText="true"
           styleClass="blai-glasses-power hiden"/>

    <Label fx:id="bottomText"
           text=""
           wrapText="true"
           styleClass="footer-text"/>
  </VBox>
</HBox>
